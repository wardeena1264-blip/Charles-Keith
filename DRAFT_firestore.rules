rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Allow updating specific fields
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'address', 'footProfile', 'savedItems'])
      );

      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
               data.uid == request.auth.uid &&
               data.email is string && data.email.size() <= 256 &&
               data.createdAt == (resource == null ? request.time : resource.data.createdAt);
      }
    }

    // --- Orders ---
    match /orders/{orderId} {
      // Users can see their own orders
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Users can create orders
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidOrder(incoming());
      
      // Orders are immutable once created (except for system updates, which we'd handle with admin rules if needed)
      allow update: if false;
      allow delete: if false;

      function isValidOrder(data) {
        return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.items is list && data.items.size() > 0 &&
               data.totalAmount is number && data.totalAmount >= 0 &&
               data.status in ['processing', 'shipped', 'delivered'] &&
               data.createdAt == request.time;
      }
    }
  }
}
